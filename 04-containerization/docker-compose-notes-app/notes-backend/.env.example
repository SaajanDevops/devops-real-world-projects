# Copy this file to .env and adjust values as needed.
# These are local-only credentials used to initialize the MongoDB
# container - they never leave the Docker network and are not real
# production secrets, but should still not be committed as a real .env.
MONGODB_INITDB_ROOT_USERNAME=root
MONGODB_INITDB_ROOT_PASSWORD=rootpassword
NOTES_DB_USER=notes_user
NOTES_DB_PASSWORD=notes_pwd
NOTES_DB_NAME=notes_db
