# Local .terraform directories
**/.terraform/*

# Terraform lock file - commit this if you want reproducible provider
# versions across machines; excluded here to keep the portfolio repo
# generic. Remove this line if you'd rather track it.
.terraform.lock.hcl

# Terraform state files - NEVER commit these. They can contain resource
# IDs, metadata, and sometimes secrets, and are meaningless without the
# exact deployed infrastructure they describe.
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Any local .tfvars files that may contain sensitive values
*.tfvars
*.tfvars.json

# Override files (local-only overrides, never meant to be shared)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
